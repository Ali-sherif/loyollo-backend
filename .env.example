# Loyollo backend — local names only. Copy to `.env` and keep secrets out of git.
# Product contracts live in loyollo-web/docs/backend/ (not duplicated here).

DATABASE_URL=postgresql://loyollo:loyollo@localhost:5432/loyollo
PORT=4000
NODE_ENV=development

# Admin URL for the Postgres instance used by e2e tests. Tests never write to
# this database; each Jest worker gets its own e2e_<run>_w<n> database.
E2E_DATABASE_URL=postgresql://loyollo:loyollo@localhost:5432/loyollo
# Optional. CI sets a unique value per job. Local `npm run test:e2e` generates one.
# E2E_RUN_ID=
# Optional. Must match Jest --maxWorkers (default 2).
# E2E_WORKER_COUNT=2

# --- Auth (ADR-005) ---------------------------------------------------------
# Required. Symmetric signing key for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Refresh tokens are opaque random values hashed in the database, not JWTs —
# there is deliberately no JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=dev-only-insecure-change-me-dev-only-insecure-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=24
EMAIL_VERIFICATION_TTL_HOURS=24
# Server-side salt mixed into hashed rate-limit tracking keys. Never a raw email in Redis.
AUTH_TRACKER_SALT=dev-only-tracker-salt-change-me

# --- Transport security (ADR-017) -------------------------------------------
# Comma-separated exact origins. No wildcard with credentials.
CORS_ORIGIN=http://localhost:3000
# Public base URL of the Next.js app; used to build emailed links.
APP_BASE_URL=http://localhost:3000

# --- Rate limiting (ADR-020) ------------------------------------------------
# Redis is a hard dependency of auth: requests are denied (503) when it is down.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Logical database index. e2e workers override this so their throttle counters
# never collide with the dev app or with each other.
REDIS_DB=0

# --- Messaging (ADR-018) ----------------------------------------------------
# `log` (dev default) or `resend`. Unknown values fail at boot.
MAILER_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="Loyollo <no-reply@loyollo.com>"
MAIL_SITE_NAME=Loyollo
# Shared secret for POST /messaging/email from the Next.js BFF. Timing-safe compare.
MESSAGING_INTERNAL_SECRET=dev-only-messaging-secret-change-me
