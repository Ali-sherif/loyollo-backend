# Loyollo backend — local names only. Copy to `.env` and keep secrets out of git.
# Product contracts live in loyollo-web/docs/backend/ (not duplicated here).

DATABASE_URL=postgresql://loyollo:loyollo@localhost:5432/loyollo
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT signing secrets (generate unique values per environment; never commit real secrets)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
APP_BASE_URL=http://localhost:3000
