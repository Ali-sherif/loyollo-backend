# Loyollo backend — local names only. Copy to `.env` and keep secrets out of git.
# Product contracts live in loyollo-web/docs/backend/ (not duplicated here).

DATABASE_URL=postgresql://loyollo:loyollo@localhost:5432/loyollo
PORT=4000

# Admin URL for the Postgres instance used by e2e tests. Tests never write to
# this database; each Jest worker gets its own e2e_<run>_w<n> database.
E2E_DATABASE_URL=postgresql://loyollo:loyollo@localhost:5432/loyollo
# Optional. CI sets a unique value per job. Local `npm run test:e2e` generates one.
# E2E_RUN_ID=
# Optional. Must match Jest --maxWorkers (default 2).
# E2E_WORKER_COUNT=2
